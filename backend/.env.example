# Sweet Crumbs Bakery Backend Configuration
PROJECT_NAME="Sweet Crumbs Bakery API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
